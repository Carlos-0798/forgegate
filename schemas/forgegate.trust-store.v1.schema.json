{
  "$defs": {
    "IdentityRole": {
      "enum": [
        "producer",
        "operator"
      ],
      "title": "IdentityRole",
      "type": "string"
    },
    "IdentityStatus": {
      "enum": [
        "active",
        "revoked"
      ],
      "title": "IdentityStatus",
      "type": "string"
    },
    "SigningIdentity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "identity_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Identity Id",
          "type": "string"
        },
        "public_key_base64": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Public Key Base64",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.signing-identity.v1",
          "default": "forgegate.signing-identity.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "display_name",
        "public_key_base64"
      ],
      "title": "SigningIdentity",
      "type": "object"
    },
    "TrustedIdentity": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/SigningIdentity"
        },
        "project_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Project Ids",
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/IdentityRole"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/IdentityStatus",
          "default": "active"
        }
      },
      "required": [
        "identity",
        "roles",
        "project_ids"
      ],
      "title": "TrustedIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "identities": {
      "items": {
        "$ref": "#/$defs/TrustedIdentity"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Identities",
      "type": "array"
    },
    "schema_version": {
      "const": "forgegate.trust-store.v1",
      "default": "forgegate.trust-store.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trust_store_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Trust Store Id",
      "type": "string"
    }
  },
  "required": [
    "trust_store_id",
    "identities"
  ],
  "title": "TrustStore",
  "type": "object"
}
