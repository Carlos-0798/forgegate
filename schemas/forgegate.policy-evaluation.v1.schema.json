{
  "$defs": {
    "Aggregation": {
      "enum": [
        "value",
        "count",
        "all",
        "any"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "PASS",
        "FAIL",
        "REVIEW",
        "ERROR"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Operator": {
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "greater_than_or_equal",
        "less_than",
        "less_than_or_equal",
        "contains",
        "exists"
      ],
      "title": "Operator",
      "type": "string"
    },
    "RuleEvaluation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "title": "Actual"
        },
        "aggregation": {
          "$ref": "#/$defs/Aggregation"
        },
        "claim": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Claim",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Evidence Kind",
          "type": "string"
        },
        "expected": {
          "title": "Expected"
        },
        "explanation": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "remediation_hint": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Hint"
        },
        "rule_id": {
          "pattern": "^[a-z][a-z0-9._-]{1,127}$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "claim",
        "decision",
        "mandatory",
        "evidence_kind",
        "aggregation",
        "operator",
        "expected",
        "actual",
        "evidence_ids",
        "reason_code",
        "explanation"
      ],
      "title": "RuleEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_commit": {
      "pattern": "^[0-9a-fA-F]{7,64}$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluated_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evaluated Evidence Ids",
      "type": "array"
    },
    "evaluation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "evidence_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Fingerprint",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "policy_name": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "title": "Policy Name",
      "type": "string"
    },
    "rule_results": {
      "items": {
        "$ref": "#/$defs/RuleEvaluation"
      },
      "minItems": 1,
      "title": "Rule Results",
      "type": "array"
    },
    "schema_version": {
      "const": "forgegate.policy-evaluation.v1",
      "default": "forgegate.policy-evaluation.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "policy_name",
    "policy_fingerprint",
    "evidence_fingerprint",
    "candidate_commit",
    "evaluated_at",
    "decision",
    "rule_results",
    "evaluated_evidence_ids"
  ],
  "title": "PolicyEvaluation",
  "type": "object"
}
