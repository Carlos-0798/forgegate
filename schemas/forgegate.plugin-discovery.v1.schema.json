{
  "$defs": {
    "DiscoveredPlugin": {
      "additionalProperties": false,
      "properties": {
        "core_api_version": {
          "const": "1",
          "default": "1",
          "title": "Core Api Version",
          "type": "string"
        },
        "distribution_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Distribution Name",
          "type": "string"
        },
        "distribution_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Distribution Version",
          "type": "string"
        },
        "entry_point_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entry Point Name",
          "type": "string"
        },
        "entry_point_value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entry Point Value",
          "type": "string"
        },
        "execution": {
          "const": "NOT_LOADED",
          "default": "NOT_LOADED",
          "title": "Execution",
          "type": "string"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginDiscoveryIssue"
          },
          "maxItems": 16,
          "title": "Issues",
          "type": "array"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginManifest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Path"
        },
        "plugin_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*){1,7}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin Id"
        },
        "status": {
          "$ref": "#/$defs/PluginDiscoveryStatus"
        }
      },
      "required": [
        "distribution_name",
        "distribution_version",
        "entry_point_name",
        "entry_point_value",
        "status"
      ],
      "title": "DiscoveredPlugin",
      "type": "object"
    },
    "PluginCapability": {
      "enum": [
        "collector",
        "evaluator",
        "exporter",
        "notifier",
        "solution-pack-metadata"
      ],
      "title": "PluginCapability",
      "type": "string"
    },
    "PluginDiscoveryIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^PLUGIN_[A-Z0-9_]{2,120}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PluginDiscoveryIssue",
      "type": "object"
    },
    "PluginDiscoveryStatus": {
      "enum": [
        "COMPATIBLE",
        "INCOMPATIBLE",
        "INVALID",
        "CONFLICT"
      ],
      "title": "PluginDiscoveryStatus",
      "type": "string"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "description": "Declarative plugin metadata; validating it never imports plugin code.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/PluginCapability"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "forgegate_api_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Forgegate Api Version",
          "type": "string"
        },
        "input_schemas": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Input Schemas",
          "type": "array"
        },
        "manifest_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "output_evidence_kinds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Output Evidence Kinds",
          "type": "array"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginPermission"
          },
          "maxItems": 16,
          "title": "Permissions",
          "type": "array"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*){1,7}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Plugin Version",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.plugin-manifest.v1",
          "default": "forgegate.plugin-manifest.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "plugin_id",
        "display_name",
        "description",
        "plugin_version",
        "forgegate_api_version",
        "capabilities"
      ],
      "title": "PluginManifest",
      "type": "object"
    },
    "PluginPermission": {
      "enum": [
        "artifact-read",
        "filesystem-write",
        "network",
        "notification",
        "secrets",
        "subprocess"
      ],
      "title": "PluginPermission",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compatible": {
      "minimum": 0,
      "title": "Compatible",
      "type": "integer"
    },
    "conflicts": {
      "minimum": 0,
      "title": "Conflicts",
      "type": "integer"
    },
    "core_operational_without_plugins": {
      "const": true,
      "default": true,
      "title": "Core Operational Without Plugins",
      "type": "boolean"
    },
    "entry_point_group": {
      "const": "forgegate.plugins.v1",
      "default": "forgegate.plugins.v1",
      "title": "Entry Point Group",
      "type": "string"
    },
    "execution": {
      "const": "NOT_LOADED",
      "default": "NOT_LOADED",
      "title": "Execution",
      "type": "string"
    },
    "incompatible": {
      "minimum": 0,
      "title": "Incompatible",
      "type": "integer"
    },
    "invalid": {
      "minimum": 0,
      "title": "Invalid",
      "type": "integer"
    },
    "plugin_api_version": {
      "const": "1",
      "default": "1",
      "title": "Plugin Api Version",
      "type": "string"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/DiscoveredPlugin"
      },
      "title": "Plugins",
      "type": "array"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "forgegate.plugin-discovery.v1",
      "default": "forgegate.plugin-discovery.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "report_id",
    "plugins",
    "total",
    "compatible",
    "incompatible",
    "invalid",
    "conflicts"
  ],
  "title": "PluginDiscoveryReport",
  "type": "object"
}
