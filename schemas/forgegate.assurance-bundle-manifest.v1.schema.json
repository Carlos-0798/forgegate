{
  "$defs": {
    "AssuranceBundleFile": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "enum": [
            "assurance-bundle.json",
            "README.md"
          ],
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "media_type",
        "size_bytes",
        "sha256"
      ],
      "title": "AssuranceBundleFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "files": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/AssuranceBundleFile"
        },
        {
          "$ref": "#/$defs/AssuranceBundleFile"
        }
      ],
      "title": "Files",
      "type": "array"
    },
    "manifest_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "forgegate.assurance-bundle-manifest.v1",
      "default": "forgegate.assurance-bundle-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "bundle_id",
    "files"
  ],
  "title": "AssuranceBundleManifest",
  "type": "object"
}
