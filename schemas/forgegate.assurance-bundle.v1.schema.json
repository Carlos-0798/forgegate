{
  "$defs": {
    "Aggregation": {
      "enum": [
        "value",
        "count",
        "all",
        "any"
      ],
      "title": "Aggregation",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path_or_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path Or Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path_or_uri",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CandidateDocument": {
      "discriminator": {
        "mapping": {
          "forgegate.release-candidate.v1": "#/$defs/ReleaseCandidate",
          "forgegate.release-candidate.v2": "#/$defs/ProfileBoundReleaseCandidate"
        },
        "propertyName": "schema_version"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReleaseCandidate"
        },
        {
          "$ref": "#/$defs/ProfileBoundReleaseCandidate"
        }
      ]
    },
    "CandidateEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "assembly": {
          "$ref": "#/$defs/EvidenceBundleAssembly"
        },
        "assembly_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assembly Fingerprint",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Id",
          "type": "string"
        },
        "bound_at": {
          "format": "date-time",
          "title": "Bound At",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/CandidateDocument"
        },
        "candidate_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.candidate-evidence-binding.v1",
          "default": "forgegate.candidate-evidence-binding.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "bound_at",
        "candidate",
        "candidate_fingerprint",
        "assembly",
        "assembly_fingerprint"
      ],
      "title": "CandidateEvidenceBinding",
      "type": "object"
    },
    "CandidateStatus": {
      "enum": [
        "DRAFT",
        "COLLECTING",
        "READY",
        "EVALUATING",
        "PASS",
        "FAIL",
        "REVIEW",
        "ERROR"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
    "CandidateTransition": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^cand-[0-9a-f]{24}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evaluation_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Id"
        },
        "from_revision": {
          "minimum": 0,
          "title": "From Revision",
          "type": "integer"
        },
        "from_status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "prior_candidate_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prior Candidate Fingerprint",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result_candidate_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Candidate Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.candidate-transition.v1",
          "default": "forgegate.candidate-transition.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "to_revision": {
          "minimum": 1,
          "title": "To Revision",
          "type": "integer"
        },
        "to_status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "transition_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "candidate_id",
        "from_status",
        "to_status",
        "from_revision",
        "to_revision",
        "prior_candidate_fingerprint",
        "result_candidate_fingerprint",
        "occurred_at"
      ],
      "title": "CandidateTransition",
      "type": "object"
    },
    "CollectionIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CollectionIssue",
      "type": "object"
    },
    "CollectionReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "collector_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Collector Name",
          "type": "string"
        },
        "collector_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Collector Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "result_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Fingerprint",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/CollectionIssue"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "collector_name",
        "collector_version",
        "result_fingerprint",
        "artifacts",
        "evidence_ids"
      ],
      "title": "CollectionReceipt",
      "type": "object"
    },
    "CollectorConfig": {
      "additionalProperties": false,
      "properties": {
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/CollectorType"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "title": "CollectorConfig",
      "type": "object"
    },
    "CollectorType": {
      "enum": [
        "junit",
        "coverage_xml",
        "lcov",
        "sarif",
        "benchmark_json",
        "manual_approval"
      ],
      "title": "CollectorType",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "PASS",
        "FAIL",
        "REVIEW",
        "ERROR"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "candidate_commit": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Candidate Commit",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "producer": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.evidence-bundle.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "producer_version",
        "candidate_commit",
        "generated_at",
        "evidence"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "EvidenceBundleAssembly": {
      "additionalProperties": false,
      "properties": {
        "assembly_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assembly Id",
          "type": "string"
        },
        "bundle": {
          "$ref": "#/$defs/EvidenceBundle"
        },
        "collections": {
          "items": {
            "$ref": "#/$defs/CollectionReceipt"
          },
          "minItems": 1,
          "title": "Collections",
          "type": "array"
        },
        "schema_version": {
          "const": "forgegate.evidence-bundle-assembly.v1",
          "default": "forgegate.evidence-bundle-assembly.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "warning_disposition": {
          "enum": [
            "none",
            "retained"
          ],
          "title": "Warning Disposition",
          "type": "string"
        }
      },
      "required": [
        "assembly_id",
        "warning_disposition",
        "bundle",
        "collections"
      ],
      "title": "EvidenceBundleAssembly",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9._-]{1,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "execution_context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "source_tool": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Tool",
          "type": "string"
        },
        "source_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        },
        "trust": {
          "$ref": "#/$defs/EvidenceTrust"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "scope",
        "value",
        "status",
        "source_tool",
        "source_version",
        "execution_context",
        "artifact",
        "collected_at",
        "trust",
        "verification_level"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceTrust": {
      "description": "How strongly ForgeGate can trust the producer identity.",
      "enum": [
        "unsigned_local",
        "claimed_ci_metadata",
        "verified_ci_identity",
        "signed_attestation"
      ],
      "title": "EvidenceTrust",
      "type": "string"
    },
    "ExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "ci_provider": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Provider"
        },
        "ci_run_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Run Id"
        },
        "commit_sha": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "operating_system": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating System"
        },
        "runtime": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "commit_sha"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "WARNING",
        "REJECTION"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "Operator": {
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "greater_than_or_equal",
        "less_than",
        "less_than_or_equal",
        "contains",
        "exists"
      ],
      "title": "Operator",
      "type": "string"
    },
    "OutputConfig": {
      "additionalProperties": false,
      "properties": {
        "json": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Json",
          "type": "string"
        },
        "markdown": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "json",
        "markdown"
      ],
      "title": "OutputConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Name",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "forgegate.policy.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "name",
        "rules"
      ],
      "title": "PolicyConfig",
      "type": "object"
    },
    "PolicyEvaluation": {
      "additionalProperties": false,
      "properties": {
        "candidate_commit": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Candidate Commit",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "evaluated_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evaluated Evidence Ids",
          "type": "array"
        },
        "evaluation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Fingerprint",
          "type": "string"
        },
        "policy_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Fingerprint",
          "type": "string"
        },
        "policy_name": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Policy Name",
          "type": "string"
        },
        "rule_results": {
          "items": {
            "$ref": "#/$defs/RuleEvaluation"
          },
          "minItems": 1,
          "title": "Rule Results",
          "type": "array"
        },
        "schema_version": {
          "const": "forgegate.policy-evaluation.v1",
          "default": "forgegate.policy-evaluation.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "policy_name",
        "policy_fingerprint",
        "evidence_fingerprint",
        "candidate_commit",
        "evaluated_at",
        "decision",
        "rule_results",
        "evaluated_evidence_ids"
      ],
      "title": "PolicyEvaluation",
      "type": "object"
    },
    "PolicyEvaluationDocument": {
      "discriminator": {
        "mapping": {
          "forgegate.policy-evaluation.v1": "#/$defs/PolicyEvaluation",
          "forgegate.policy-evaluation.v2": "#/$defs/ProfileAuthorizedPolicyEvaluation"
        },
        "propertyName": "schema_version"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PolicyEvaluation"
        },
        {
          "$ref": "#/$defs/ProfileAuthorizedPolicyEvaluation"
        }
      ]
    },
    "PolicyMaterial": {
      "additionalProperties": false,
      "description": "Exact policy bytes authorized by one immutable project profile.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "content_base64": {
          "maxLength": 1398104,
          "minLength": 4,
          "title": "Content Base64",
          "type": "string"
        },
        "material_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Material Id",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/PolicyConfig"
        },
        "policy_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Fingerprint",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_profile_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Project Profile Id",
          "type": "string"
        },
        "project_profile_version": {
          "minimum": 1,
          "title": "Project Profile Version",
          "type": "integer"
        },
        "release_track": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Release Track",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.policy-material.v1",
          "default": "forgegate.policy-material.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "project_id",
        "project_profile_id",
        "project_profile_version",
        "release_track",
        "artifact",
        "content_base64",
        "policy",
        "policy_fingerprint"
      ],
      "title": "PolicyMaterial",
      "type": "object"
    },
    "PolicyRule": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/Aggregation",
          "default": "value"
        },
        "claim": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Claim",
          "type": "string"
        },
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Evidence Kind",
          "type": "string"
        },
        "expected": {
          "title": "Expected"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9._-]{1,127}$",
          "title": "Id",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "maximum_age_seconds": {
          "anyOf": [
            {
              "maximum": 315576000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Age Seconds"
        },
        "minimum_trust": {
          "$ref": "#/$defs/EvidenceTrust",
          "default": "unsigned_local"
        },
        "minimum_verification": {
          "$ref": "#/$defs/VerificationLevel",
          "default": "declared"
        },
        "on_missing": {
          "$ref": "#/$defs/Decision",
          "default": "REVIEW"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "require_presence": {
          "default": true,
          "title": "Require Presence",
          "type": "boolean"
        },
        "where": {
          "additionalProperties": true,
          "title": "Where",
          "type": "object"
        }
      },
      "required": [
        "id",
        "claim",
        "evidence_kind",
        "operator",
        "expected"
      ],
      "title": "PolicyRule",
      "type": "object"
    },
    "ProfileAuthorizedPolicyEvaluation": {
      "additionalProperties": false,
      "properties": {
        "candidate_commit": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Candidate Commit",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "evaluated_at": {
          "format": "date-time",
