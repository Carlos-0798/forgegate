{
  "$defs": {
    "CandidateStatus": {
      "enum": [
        "DRAFT",
        "COLLECTING",
        "READY",
        "EVALUATING",
        "PASS",
        "FAIL",
        "REVIEW",
        "ERROR"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
    "ReleaseCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^cand-[0-9a-f]{24}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evaluated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "evaluation_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Id"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Project Id",
          "type": "string"
        },
        "release_track": {
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "title": "Release Track",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "forgegate.release-candidate.v1",
          "default": "forgegate.release-candidate.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_branch": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Branch",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CandidateStatus",
          "default": "DRAFT"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "project_id",
        "version",
        "commit_sha",
        "source_branch",
        "release_track",
        "created_at",
        "updated_at"
      ],
      "title": "ReleaseCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bounded project-scoped page of current candidate snapshots.",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/ReleaseCandidate"
      },
      "maxItems": 200,
      "title": "Candidates",
      "type": "array"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "next_after_candidate_id": {
      "anyOf": [
        {
          "pattern": "^cand-[0-9a-f]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next After Candidate Id"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "forgegate.release-candidate-page.v1",
      "default": "forgegate.release-candidate-page.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "candidates",
    "has_more"
  ],
  "title": "ReleaseCandidatePage",
  "type": "object"
}
