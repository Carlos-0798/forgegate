{
  "$defs": {
    "CandidateStatus": {
      "enum": [
        "DRAFT",
        "COLLECTING",
        "READY",
        "EVALUATING",
        "PASS",
        "FAIL",
        "REVIEW",
        "ERROR"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
    "CandidateTransition": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^cand-[0-9a-f]{24}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evaluation_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Id"
        },
        "from_revision": {
          "minimum": 0,
          "title": "From Revision",
          "type": "integer"
        },
        "from_status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "prior_candidate_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prior Candidate Fingerprint",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result_candidate_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Candidate Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.candidate-transition.v1",
          "default": "forgegate.candidate-transition.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "to_revision": {
          "minimum": 1,
          "title": "To Revision",
          "type": "integer"
        },
        "to_status": {
          "$ref": "#/$defs/CandidateStatus"
        },
        "transition_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "candidate_id",
        "from_status",
        "to_status",
        "from_revision",
        "to_revision",
        "prior_candidate_fingerprint",
        "result_candidate_fingerprint",
        "occurred_at"
      ],
      "title": "CandidateTransition",
      "type": "object"
    },
    "ReleaseCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^cand-[0-9a-f]{24}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evaluated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "evaluation_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Id"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Project Id",
          "type": "string"
        },
        "release_track": {
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "title": "Release Track",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "forgegate.release-candidate.v1",
          "default": "forgegate.release-candidate.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_branch": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Branch",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CandidateStatus",
          "default": "DRAFT"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "project_id",
        "version",
        "commit_sha",
        "source_branch",
        "release_track",
        "created_at",
        "updated_at"
      ],
      "title": "ReleaseCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/ReleaseCandidate"
    },
    "schema_version": {
      "const": "forgegate.candidate-transition-result.v1",
      "default": "forgegate.candidate-transition-result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "transition": {
      "$ref": "#/$defs/CandidateTransition"
    }
  },
  "required": [
    "candidate",
    "transition"
  ],
  "title": "CandidateTransitionResult",
  "type": "object"
}
