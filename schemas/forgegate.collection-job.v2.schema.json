{
  "additionalProperties": false,
  "description": "Current record with visible, non-credential execution ownership and renewals.",
  "properties": {
    "authority": {
      "default": "LOCAL_CLI_NOT_AUTHENTICATED",
      "enum": [
        "LOCAL_CLI_NOT_AUTHENTICATED",
        "AUTHENTICATED_DASHBOARD"
      ],
      "title": "Authority",
      "type": "string"
    },
    "candidate_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Fingerprint",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^cand-[0-9a-f]{24}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_write": {
      "const": "NOT_PERFORMED",
      "default": "NOT_PERFORMED",
      "title": "Candidate Write",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "JOB_EXECUTION_FAILED",
            "JOB_LEASE_EXPIRED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "execution_owner_id": {
      "anyOf": [
        {
          "pattern": "^executor-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Owner Id"
    },
    "job_id": {
      "pattern": "^job-[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "lease_renewal_count": {
      "default": 0,
      "maximum": 62,
      "minimum": 0,
      "title": "Lease Renewal Count",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "title": "Project Id",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "result_fingerprint": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Fingerprint"
    },
    "revision": {
      "default": 0,
      "maximum": 64,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "forgegate.collection-job.v2",
      "default": "forgegate.collection-job.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_bytes": {
      "default": "retained_pending",
      "enum": [
        "retained_pending",
        "released_logically"
      ],
      "title": "Source Bytes",
      "type": "string"
    },
    "state": {
      "default": "QUEUED",
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "REVIEW_REQUIRED",
        "REJECTED",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "candidate_id",
    "project_id",
    "candidate_fingerprint",
    "request_fingerprint",
    "created_at",
    "updated_at"
  ],
  "title": "CollectionJobRecord",
  "type": "object"
}
