{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path_or_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path Or Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path_or_uri",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9._-]{1,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "execution_context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "source_tool": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Tool",
          "type": "string"
        },
        "source_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        },
        "trust": {
          "$ref": "#/$defs/EvidenceTrust"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "scope",
        "value",
        "status",
        "source_tool",
        "source_version",
        "execution_context",
        "artifact",
        "collected_at",
        "trust",
        "verification_level"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceTrust": {
      "description": "How strongly ForgeGate can trust the producer identity.",
      "enum": [
        "unsigned_local",
        "claimed_ci_metadata",
        "verified_ci_identity",
        "signed_attestation"
      ],
      "title": "EvidenceTrust",
      "type": "string"
    },
    "ExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "ci_provider": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Provider"
        },
        "ci_run_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Run Id"
        },
        "commit_sha": {
          "pattern": "^[0-9a-fA-F]{7,64}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "operating_system": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating System"
        },
        "runtime": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "commit_sha"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "VerificationLevel": {
      "description": "What kind of engineering observation the evidence represents.",
      "enum": [
        "declared",
        "simulated",
        "replayed",
        "host_tested",
        "target_built",
        "ci_validated",
        "system_observed",
        "physically_verified"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_commit": {
      "pattern": "^[0-9a-fA-F]{7,64}$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "producer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Producer Version",
      "type": "string"
    },
    "schema_version": {
      "const": "forgegate.evidence-bundle.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "producer_version",
    "candidate_commit",
    "generated_at",
    "evidence"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
