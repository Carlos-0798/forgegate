{
  "$defs": {
    "Decision": {
      "enum": [
        "PASS",
        "FAIL",
        "REVIEW",
        "ERROR"
      ],
      "title": "Decision",
      "type": "string"
    },
    "GitHubConclusion": {
      "enum": [
        "success",
        "failure",
        "action_required"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned result of binding one verified assurance bundle to a CI commit.",
  "properties": {
    "assurance": {
      "const": "unsigned_local",
      "default": "unsigned_local",
      "title": "Assurance",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "candidate_commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^cand-[0-9a-f]{24}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "commit_binding": {
      "const": "exact",
      "default": "exact",
      "title": "Commit Binding",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "expected_commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Expected Commit",
      "type": "string"
    },
    "integration": {
      "const": "github-actions",
      "default": "github-actions",
      "title": "Integration",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "title": "Project Id",
      "type": "string"
    },
    "recommended_conclusion": {
      "$ref": "#/$defs/GitHubConclusion"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "forgegate.github-action-report.v1",
      "default": "forgegate.github-action-report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact_bytes": {
      "const": "not_embedded",
      "default": "not_embedded",
      "title": "Source Artifact Bytes",
      "type": "string"
    },
    "status": {
      "const": "VALID",
      "default": "VALID",
      "title": "Status",
      "type": "string"
    },
    "verification_scope": {
      "const": "retained_documents_and_embedded_policy_bytes",
      "default": "retained_documents_and_embedded_policy_bytes",
      "title": "Verification Scope",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "bundle_id",
    "manifest_id",
    "project_id",
    "candidate_id",
    "candidate_commit",
    "expected_commit",
    "decision",
    "recommended_conclusion"
  ],
  "title": "GitHubActionReport",
  "type": "object"
}
