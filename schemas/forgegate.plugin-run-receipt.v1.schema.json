{
  "$defs": {
    "PluginCapability": {
      "enum": [
        "collector",
        "evaluator",
        "exporter",
        "notifier",
        "solution-pack-metadata"
      ],
      "title": "PluginCapability",
      "type": "string"
    },
    "PluginCleanupResult": {
      "additionalProperties": false,
      "description": "Cleanup proof without retaining a host path or container identifier.",
      "properties": {
        "container_removed": {
          "title": "Container Removed",
          "type": "boolean"
        },
        "staging_removed": {
          "title": "Staging Removed",
          "type": "boolean"
        }
      },
      "required": [
        "container_removed",
        "staging_removed"
      ],
      "title": "PluginCleanupResult",
      "type": "object"
    },
    "PluginExecutionSummary": {
      "additionalProperties": false,
      "description": "Bounded, path-free execution metadata retained by the broker.",
      "properties": {
        "completion_observed": {
          "title": "Completion Observed",
          "type": "boolean"
        },
        "elapsed_ms": {
          "maximum": 900000,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": -255,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "oom_killed": {
          "default": false,
          "title": "Oom Killed",
          "type": "boolean"
        },
        "ready_observed": {
          "title": "Ready Observed",
          "type": "boolean"
        },
        "runner_started": {
          "title": "Runner Started",
          "type": "boolean"
        },
        "stderr_bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Stderr Bytes",
          "type": "integer"
        },
        "stderr_truncated": {
          "default": false,
          "title": "Stderr Truncated",
          "type": "boolean"
        },
        "stdout_bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Stdout Bytes",
          "type": "integer"
        },
        "stdout_truncated": {
          "default": false,
          "title": "Stdout Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "runner_started",
        "ready_observed",
        "completion_observed",
        "elapsed_ms",
        "stdout_bytes",
        "stderr_bytes"
      ],
      "title": "PluginExecutionSummary",
      "type": "object"
    },
    "PluginExecutionTarget": {
      "additionalProperties": false,
      "description": "Pinned metadata for a discovered plugin without importing its entry point.",
      "properties": {
        "distribution_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Distribution Name",
          "type": "string"
        },
        "distribution_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Distribution Version",
          "type": "string"
        },
        "entry_point_name": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*){1,7}$",
          "title": "Entry Point Name",
          "type": "string"
        },
        "entry_point_value": {
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Entry Point Value",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/PluginManifest"
        }
      },
      "required": [
        "distribution_name",
        "distribution_version",
        "entry_point_name",
        "entry_point_value",
        "manifest"
      ],
      "title": "PluginExecutionTarget",
      "type": "object"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "description": "Declarative plugin metadata; validating it never imports plugin code.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/PluginCapability"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "forgegate_api_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Forgegate Api Version",
          "type": "string"
        },
        "input_schemas": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Input Schemas",
          "type": "array"
        },
        "manifest_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "output_evidence_kinds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Output Evidence Kinds",
          "type": "array"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginPermission"
          },
          "maxItems": 16,
          "title": "Permissions",
          "type": "array"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*){1,7}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Plugin Version",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.plugin-manifest.v1",
          "default": "forgegate.plugin-manifest.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "plugin_id",
        "display_name",
        "description",
        "plugin_version",
        "forgegate_api_version",
        "capabilities"
      ],
      "title": "PluginManifest",
      "type": "object"
    },
    "PluginPermission": {
      "enum": [
        "artifact-read",
        "filesystem-write",
        "network",
        "notification",
        "secrets",
        "subprocess"
      ],
      "title": "PluginPermission",
      "type": "string"
    },
    "PluginProtocolDirection": {
      "enum": [
        "CORE_TO_PLUGIN",
        "PLUGIN_TO_CORE"
      ],
      "title": "PluginProtocolDirection",
      "type": "string"
    },
    "PluginProtocolMessage": {
      "additionalProperties": false,
      "description": "Strict, bounded message envelope for the future runner protocol.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/PluginProtocolDirection"
        },
        "issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRunIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/PluginProtocolMessageKind"
        },
        "message_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Message Id",
          "type": "string"
        },
        "output_set_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Set Id"
        },
        "protocol_version": {
          "const": "1",
          "default": "1",
          "title": "Protocol Version",
          "type": "string"
        },
        "run_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRunPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_plan_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.plugin-protocol-message.v1",
          "default": "forgegate.plugin-protocol-message.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "maximum": 2,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "message_id",
        "run_plan_id",
        "sequence",
        "direction",
        "kind"
      ],
      "title": "PluginProtocolMessage",
      "type": "object"
    },
    "PluginProtocolMessageKind": {
      "enum": [
        "START",
        "READY",
        "RESULT",
        "ERROR"
      ],
      "title": "PluginProtocolMessageKind",
      "type": "string"
    },
    "PluginResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "cpu_time_ms": {
          "default": 30000,
          "maximum": 900000,
          "minimum": 100,
          "title": "Cpu Time Ms",
          "type": "integer"
        },
        "file_count": {
          "default": 64,
          "maximum": 4096,
          "minimum": 1,
          "title": "File Count",
          "type": "integer"
        },
        "memory_bytes": {
          "default": 268435456,
          "maximum": 4294967296,
          "minimum": 16777216,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "output_bytes": {
          "default": 67108864,
          "maximum": 1073741824,
          "minimum": 1024,
          "title": "Output Bytes",
          "type": "integer"
        },
        "process_count": {
          "const": 1,
          "default": 1,
          "title": "Process Count",
          "type": "integer"
        },
        "startup_timeout_ms": {
          "default": 5000,
          "maximum": 120000,
          "minimum": 100,
          "title": "Startup Timeout Ms",
          "type": "integer"
        },
        "stderr_bytes": {
          "default": 1048576,
          "maximum": 16777216,
          "minimum": 0,
          "title": "Stderr Bytes",
          "type": "integer"
        },
        "stdout_bytes": {
          "default": 1048576,
          "maximum": 16777216,
          "minimum": 0,
          "title": "Stdout Bytes",
          "type": "integer"
        },
        "total_timeout_ms": {
          "default": 60000,
          "maximum": 900000,
          "minimum": 100,
          "title": "Total Timeout Ms",
          "type": "integer"
        }
      },
      "title": "PluginResourceLimits",
      "type": "object"
    },
    "PluginRunIssue": {
      "additionalProperties": false,
      "description": "Stable, non-secret-bearing failure classification.",
      "properties": {
        "code": {
          "$ref": "#/$defs/PluginRunIssueCode"
        }
      },
      "required": [
        "code"
      ],
      "title": "PluginRunIssue",
      "type": "object"
    },
    "PluginRunIssueCode": {
      "enum": [
        "PLUGIN_PLAN_INVALID",
        "PLUGIN_PERMISSION_DENIED",
        "PLUGIN_PERMISSION_UNENFORCEABLE",
        "PLUGIN_ISOLATION_UNAVAILABLE",
        "PLUGIN_START_FAILED",
        "PLUGIN_PROTOCOL_INVALID",
        "PLUGIN_TIMEOUT",
        "PLUGIN_RESOURCE_LIMIT",
        "PLUGIN_EXIT_ERROR",
        "PLUGIN_OUTPUT_INVALID",
        "PLUGIN_AUDIT_FAILED",
        "PLUGIN_CLEANUP_FAILED",
        "PLUGIN_CANCELLED"
      ],
      "title": "PluginRunIssueCode",
      "type": "string"
    },
    "PluginRunPlan": {
      "additionalProperties": false,
      "description": "Content-addressed authority envelope for one future plugin invocation.",
      "properties": {
        "approved_permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginPermission"
          },
          "maxItems": 16,
          "title": "Approved Permissions",
          "type": "array"
        },
        "capability": {
          "$ref": "#/$defs/PluginCapability"
        },
        "declared_permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginPermission"
          },
          "maxItems": 16,
          "title": "Declared Permissions",
          "type": "array"
        },
        "enforced_permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginPermission"
          },
          "maxItems": 16,
          "title": "Enforced Permissions",
          "type": "array"
        },
        "enforcement_backend": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Enforcement Backend",
          "type": "string"
        },
        "enforcement_backend_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Enforcement Backend Version",
          "type": "string"
        },
        "environment_policy": {
          "const": "sanitized-empty",
          "default": "sanitized-empty",
          "title": "Environment Policy",
          "type": "string"
        },
        "expected_output_evidence_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Expected Output Evidence Kinds",
          "type": "array"
        },
        "input_policy": {
          "const": "broker-private-read-only",
          "default": "broker-private-read-only",
          "title": "Input Policy",
          "type": "string"
        },
        "input_schema": {
          "title": "Input Schema",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/PluginRunSubject"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "isolation_tier": {
          "const": "SANDBOXED",
          "default": "SANDBOXED",
          "title": "Isolation Tier",
          "type": "string"
        },
        "network_policy": {
          "const": "deny",
          "default": "deny",
          "title": "Network Policy",
          "type": "string"
        },
        "planned_at": {
          "format": "date-time",
          "title": "Planned At",
          "type": "string"
        },
        "resource_limits": {
          "$ref": "#/$defs/PluginResourceLimits"
        },
        "run_plan_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.plugin-run-plan.v1",
          "default": "forgegate.plugin-run-plan.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subprocess_policy": {
          "const": "deny",
          "default": "deny",
          "title": "Subprocess Policy",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PluginExecutionTarget"
        }
      },
      "required": [
        "run_plan_id",
        "target",
        "capability",
        "input_schema",
        "inputs",
        "expected_output_evidence_kinds",
        "enforcement_backend",
        "enforcement_backend_version",
        "resource_limits",
        "planned_at"
      ],
      "title": "PluginRunPlan",
      "type": "object"
    },
    "PluginRunResult": {
      "additionalProperties": false,
      "description": "Terminal, replay-verifiable record of a plugin run state chain.",
      "properties": {
        "issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRunIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_set_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Set Id"
        },
        "result_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "run_plan": {
          "$ref": "#/$defs/PluginRunPlan"
        },
        "schema_version": {
          "const": "forgegate.plugin-run-result.v1",
          "default": "forgegate.plugin-run-result.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PluginRunState"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/PluginRunTransition"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Transitions",
          "type": "array"
        },
        "validated_outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PluginValidatedOutput"
          },
          "maxItems": 4096,
          "title": "Validated Outputs",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "run_plan",
        "status",
        "transitions"
      ],
      "title": "PluginRunResult",
      "type": "object"
    },
    "PluginRunState": {
      "enum": [
        "PLANNED",
        "STARTING",
        "RUNNING",
        "SUCCEEDED",
        "ERROR",
        "CANCELLED"
      ],
      "title": "PluginRunState",
      "type": "string"
    },
    "PluginRunSubject": {
      "additionalProperties": false,
      "description": "Broker-owned logical artifact presented to a plugin runner.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}$",
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4294967296,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "media_type",
        "digest",
        "size_bytes"
      ],
      "title": "PluginRunSubject",
      "type": "object"
    },
    "PluginRunTransition": {
      "additionalProperties": false,
      "description": "One content-addressed transition in a plugin run state chain.",
      "properties": {
        "from_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRunState"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginRunIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "output_set_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Set Id"
        },
        "previous_transition_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Transition Id"
        },
        "protocol_message_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Message Id"
        },
        "run_plan_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Run Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "forgegate.plugin-run-transition.v1",
          "default": "forgegate.plugin-run-transition.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "maximum": 3,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "to_state": {
          "$ref": "#/$defs/PluginRunState"
        },
        "transition_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "run_plan_id",
        "sequence",
        "from_state",
        "to_state",
        "occurred_at"
      ],
      "title": "PluginRunTransition",
      "type": "object"
    },
    "PluginValidatedOutput": {
      "additionalProperties": false,
      "description": "Output accepted only after broker rehashing and core schema validation.",
      "properties": {
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9._-]{1,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Evidence Kind",
          "type": "string"
        },
        "output_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Id",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/PluginRunSubject"
        },
        "validation": {
          "const": "CORE_REHASHED_AND_SCHEMA_VALIDATED",
          "default": "CORE_REHASHED_AND_SCHEMA_VALIDATED",
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "output_id",
        "subject",
        "evidence_kind",
        "evidence_id"
      ],
      "title": "PluginValidatedOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Self-validating terminal broker record persisted in plugin_runs.",
  "properties": {
    "accepted_outputs_registered": {
      "title": "Accepted Outputs Registered",
      "type": "boolean"
    },
    "cleanup": {
      "$ref": "#/$defs/PluginCleanupResult"
    },
    "execution": {
      "$ref": "#/$defs/PluginExecutionSummary"
    },
    "protocol_messages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PluginProtocolMessage"
      },
      "maxItems": 3,
      "title": "Protocol Messages",
      "type": "array"
    },
    "receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "recovered_after_interruption": {
      "default": false,
      "title": "Recovered After Interruption",
      "type": "boolean"
    },
    "result": {
      "$ref": "#/$defs/PluginRunResult"
    },
    "schema_version": {
      "const": "forgegate.plugin-run-receipt.v1",
      "default": "forgegate.plugin-run-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "result",
    "execution",
    "cleanup",
    "accepted_outputs_registered"
  ],
  "title": "PluginRunReceipt",
  "type": "object"
}
