{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path_or_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path Or Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path_or_uri",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic path-free receipt for a newly created project template.",
  "properties": {
    "configuration_validation": {
      "const": "STRICT_MODELS_VALIDATED",
      "default": "STRICT_MODELS_VALIDATED",
      "title": "Configuration Validation",
      "type": "string"
    },
    "created_files": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Created Files",
      "type": "array"
    },
    "ensured_directories": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Ensured Directories",
      "type": "array"
    },
    "hardware_access": {
      "const": "NOT_REQUESTED",
      "default": "NOT_REQUESTED",
      "title": "Hardware Access",
      "type": "string"
    },
    "initialization_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Initialization Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "forgegate.initialization-report.v1",
      "default": "forgegate.initialization-report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "INITIALIZED",
      "default": "INITIALIZED",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "initialization_id",
    "project_id",
    "created_files",
    "ensured_directories"
  ],
  "title": "InitializationReport",
  "type": "object"
}
