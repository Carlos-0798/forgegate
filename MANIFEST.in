prune examples/plugin-sdk/sample-collector-plugin/src/forgegate_sample_collector_plugin.egg-info
recursive-include requirements *.txt
recursive-include reports *.md *.json
recursive-include schemas *.json *.md
recursive-include tests *.py *.json *.md
recursive-include tools *.py *.ps1 *.sh
