include .editorconfig
include .python-version
include AGENTS.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
recursive-include docs *.md *.svg *.jpg *.png
include package.json
include pnpm-lock.yaml
recursive-include frontend *.html *.css *.ts *.json
recursive-include src/forgegate/dashboard/static *
recursive-include examples *.yaml *.xml *.info *.sarif *.json *.md
recursive-include examples/plugin-sdk *.toml *.py
prune examples/plugin-sdk/sample-collector-plugin/build
prune examples/plugin-sdk/sample-collector-plugin/src/forgegate_sample_collector_plugin.egg-info
recursive-include requirements *.txt
recursive-include reports *.md *.json
prune reports/forgegate-progress-resume-handoff-*
recursive-include schemas *.json *.md
recursive-include tests *.py *.json *.md
recursive-include tools *.py *.ps1 *.sh
