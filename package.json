{
  "name": "forgegate-dashboard-build",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Build-only tooling for the packaged ForgeGate local Dashboard",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:dashboard": "vite build --config frontend/vite.config.ts",
    "check:dashboard": "tsc --project frontend/tsconfig.json --noEmit",
    "inventory:dashboard": "python tools/dashboard_assets.py --write",
    "verify:dashboard-assets": "python tools/dashboard_assets.py --check"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0"
}
